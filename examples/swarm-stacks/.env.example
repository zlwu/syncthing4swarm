# Copy to the private /opt/swarm-stacks/.env on trusted managers.
# Never commit the real file.
STGUIAPIKEY=replace-with-a-local-secret
SYNCTHING_PORT=8384
SYNCTHING_SYNC_PORT=22000
SYNCTHING_FOLDER_ID=swarm-stacks
SYNCTHING_FOLDER_PATH=/var/syncthing/data
SYNCTHING_FOLDER_LABEL=Swarm deployment control
PUID=0
PGID=0
UMASK=077
